# Alpaca REST credentials (server only)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional legacy browser streaming. Any values here are public.
# Leave both empty for REST snapshots and historical charts without streaming.
NEXT_PUBLIC_ALPACA_API_KEY=
NEXT_PUBLIC_ALPACA_API_SECRET=

# Supabase public project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Anthropic credential (server only)
ANTHROPIC_API_KEY=
